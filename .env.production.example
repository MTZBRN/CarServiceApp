# TEMPLATE ONLY. Copy to /etc/carserviceapp/.env.production with mode 0600 later.
# Never use this template directly: signing/scope placeholders intentionally fail validation.
# Shell variables override --env-file values. Use a clean administrative shell.
COMPOSE_PROJECT_NAME=carserviceapp
APP_IMAGE_TAG=REPLACE_WITH_REVIEWED_COMMIT
DATA_PATH=/opt/carserviceapp/data
UPLOADS_PATH=/opt/carserviceapp/uploads
FRONTEND_BIND_PORT=5173
JWT_KEY=__GENERATE_64_RANDOM_BYTES_BASE64_ON_SERVER__
JWT_ISSUER=urn:example:carserviceapp:issuer
JWT_AUDIENCE=urn:example:carserviceapp:client
# No InitialAdmin password belongs in the long-lived service environment.
# ASPNETCORE_ENVIRONMENT, database/upload container paths and trusted frontend IP
# are fixed in docker-compose.yml; see PRODUCTION_ARCHITECTURE.md.
